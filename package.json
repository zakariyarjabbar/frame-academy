{
  "name": "frame-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/check-origin.mjs && next build",
    "build:share": "node scripts/check-origin.mjs --required && next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "media": "tsx scripts/generate-media.ts",
    "social": "node scripts/social-image.mjs",
    "verify:export": "tsx scripts/verify-export.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:finish": "node scripts/browser-finish-check.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.6",
    "@fontsource/dm-sans": "^5.2.6",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "^0.35.4",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
